# Copy to .env and fill in what you need. Every variable here is optional:
# the ranking runs with an empty .env.
#
# These four are the only environment variables any code in this repository
# reads. (Check: grep -rn "os.getenv" tools/ execution/ demo_pipeline.py)

# Natural-language explanations. Without it, run demo_pipeline.py with
# --no-explanations.
ANTHROPIC_API_KEY=

# Real commute times from the TfL Journey Planner. Without it,
# tools/fetch_tfl_commute.py falls back to haversine distance plus noise.
TFL_APP_KEY=

# The ScanSan property API. Currently unused: tools/fetch_scansan.py has
# USE_MOCK_DATA hard-coded to True, so setting this changes nothing in the
# pipeline. execution/scansan_api.py is the client written against the real
# API and does read it.
SCANSAN_API_KEY=
SCANSAN_BASE_URL=https://api.scansan.com/v1
